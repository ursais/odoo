<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_users_view_form_inherit_auth_session_management" model="ir.ui.view">
        <field name="name">res.users.view.form.inherit.auth.session.management</field>
        <field name="model">res.users</field>
        <field name="priority" eval="16"/>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='oauth_provider_id']" position="after">
                <field name="oauth_password_changed" readonly="1" groups="base.group_user"/>
            </xpath>
        </field>
    </record>

    <record id="res_users_view_tree_inherit_auth_session_management" model="ir.ui.view">
        <field name="name">res.users.view.tree.inherit.auth.session.management</field>
        <field name="model">res.users</field>
        <field name="priority" eval="16"/>
        <field name="inherit_id" ref="base.view_users_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='oauth_provider_id']" position="after">
                <field name="oauth_password_changed" optional="hide" groups="base.group_user"/>
            </xpath>
        </field>
    </record>
</odoo>
